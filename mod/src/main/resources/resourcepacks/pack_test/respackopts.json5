{
  id: "hmi",
  version: 9,
  capabilities: ["FileFilter", "DirFilter"],
  conf: {
    zOffset: { 
      type: "number",
      default: 0,
      min: -1,
      max: 1
    },
    xOffset: {
      type: "number",
      default: 0,
      min: -1,
      max: 1
    },
    yOffset: {
      type: "number",
      default: 0,
      min: -1,
      max: 1
    },
    inspectKeybind: {
      type: "integer",
      default: 74
    }
  }
}